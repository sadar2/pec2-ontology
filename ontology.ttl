@prefix : <http://www.semanticweb.org/sadar/pec2#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/sadar/pec2#> .

<http://www.semanticweb.org/sadar/pec2#> rdf:type owl:Ontology ;
                                          rdfs:comment "This ontology models medical devices, incidents, risks and corrective actions to support risk management and safety analysis." ,
                                                       "https://creativecommons.org/licenses/by/4.0/" ;
                                          rdfs:label "Medical Device Risk Management Ontology" .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/sadar/pec2##hasCorrectiveAction
<http://www.semanticweb.org/sadar/pec2##hasCorrectiveAction> rdf:type owl:ObjectProperty ;
                                                             owl:inverseOf <http://www.semanticweb.org/sadar/pec2##isCorrectiveActionFor> ;
                                                             rdfs:domain [ rdf:type owl:Restriction ;
                                                                           owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                           owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Incident>
                                                                         ] ;
                                                             rdfs:range [ rdf:type owl:Restriction ;
                                                                          owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                          owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##CorrectiveAction>
                                                                        ] ;
                                                             rdfs:comment "Relates an Incident to a CorrectiveAction applied to it." ;
                                                             rdfs:label "hasCorrectiveAction" .


###  http://www.semanticweb.org/sadar/pec2##hasManufacturer
<http://www.semanticweb.org/sadar/pec2##hasManufacturer> rdf:type owl:ObjectProperty ;
                                                         owl:inverseOf <http://www.semanticweb.org/sadar/pec2##manufactures> ;
                                                         rdf:type owl:InverseFunctionalProperty ;
                                                         rdfs:domain [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                       owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Device>
                                                                     ] ;
                                                         rdfs:range [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                      owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Manufacturer>
                                                                    ] ;
                                                         rdfs:comment "Relates a Device to its Manufacturer." ;
                                                         rdfs:label "hasManufacturer" .


###  http://www.semanticweb.org/sadar/pec2##hasRisk
<http://www.semanticweb.org/sadar/pec2##hasRisk> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                                 rdfs:domain [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                               owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Incident>
                                                             ] ;
                                                 rdfs:range [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                              owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Risk>
                                                            ] ;
                                                 rdfs:comment "Relates an Incident to an identified Risk." ;
                                                 rdfs:label "hasRisk" .


###  http://www.semanticweb.org/sadar/pec2##hasRiskClass
<http://www.semanticweb.org/sadar/pec2##hasRiskClass> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                    owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Device>
                                                                  ] ;
                                                      rdfs:range [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##RiskClass>
                                                                 ] ;
                                                      rdfs:comment "Relates a Device to its RiskClass." ;
                                                      rdfs:label "hasRiskClass" .


###  http://www.semanticweb.org/sadar/pec2##involvesDevice
<http://www.semanticweb.org/sadar/pec2##involvesDevice> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain [ rdf:type owl:Restriction ;
                                                                      owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                      owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Incident>
                                                                    ] ;
                                                        rdfs:range [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                     owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Device>
                                                                   ] ;
                                                        rdfs:comment "Relates an Incident to the Device involved in it." ;
                                                        rdfs:label "involvesDevice" .


###  http://www.semanticweb.org/sadar/pec2##isCorrectiveActionFor
<http://www.semanticweb.org/sadar/pec2##isCorrectiveActionFor> rdf:type owl:ObjectProperty ,
                                                                        owl:InverseFunctionalProperty ;
                                                               rdfs:domain [ rdf:type owl:Restriction ;
                                                                             owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                             owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##CorrectiveAction>
                                                                           ] ;
                                                               rdfs:range [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                            owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Incident>
                                                                          ] ;
                                                               rdfs:comment "Relates a CorrectiveAction to the Incident it addresses." ;
                                                               rdfs:label "isCorrectiveActionFor" .


###  http://www.semanticweb.org/sadar/pec2##manufactures
<http://www.semanticweb.org/sadar/pec2##manufactures> rdf:type owl:ObjectProperty ,
                                                               owl:InverseFunctionalProperty ;
                                                      rdfs:domain [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                    owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Manufacturer>
                                                                  ] ;
                                                      rdfs:range [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                   owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Device>
                                                                 ] ;
                                                      rdfs:comment "Relates a Manufacturer to the Devices it produces." ;
                                                      rdfs:label "manufactures" .


###  http://www.semanticweb.org/sadar/pec2##reportedBy
<http://www.semanticweb.org/sadar/pec2##reportedBy> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                  owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Incident>
                                                                ] ;
                                                    rdfs:range [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                 owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Manufacturer>
                                                               ] ;
                                                    rdfs:comment "Relates an Incident to the Manufacturer that reported it." ;
                                                    rdfs:label "reportedBy" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/sadar/pec2##actionType
<http://www.semanticweb.org/sadar/pec2##actionType> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain <http://www.semanticweb.org/sadar/pec2##CorrectiveAction> ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "Stores the type of a CorrectiveAction." ;
                                                    rdfs:label "actionType" .


###  http://www.semanticweb.org/sadar/pec2##deviceId
<http://www.semanticweb.org/sadar/pec2##deviceId> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <http://www.semanticweb.org/sadar/pec2##Manufacturer> ;
                                                  rdfs:range xsd:string ;
                                                  rdfs:comment "Stores the country of a Manufacturer." ;
                                                  rdfs:label "country" .


###  http://www.semanticweb.org/sadar/pec2##deviceIdentifier
<http://www.semanticweb.org/sadar/pec2##deviceIdentifier> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <http://www.semanticweb.org/sadar/pec2##Device> ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasRiskClass> ;
                                                                        owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##RiskClass>
                                                                      ] ;
                                                          rdfs:range xsd:string ;
                                                          rdfs:comment "Stores the identifier of a Device." ;
                                                          rdfs:label "deviceIdentifier" .


###  http://www.semanticweb.org/sadar/pec2##deviceName
<http://www.semanticweb.org/sadar/pec2##deviceName> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain <http://www.semanticweb.org/sadar/pec2##Device> ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "Stores the name of a Device." ;
                                                    rdfs:label "deviceName" .


###  http://www.semanticweb.org/sadar/pec2##deviceType
<http://www.semanticweb.org/sadar/pec2##deviceType> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain <http://www.semanticweb.org/sadar/pec2##Device> ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "Stores the type of a Device as a controlled literal value." ;
                                                    rdfs:label "deviceType" .


###  http://www.semanticweb.org/sadar/pec2##incidentId
<http://www.semanticweb.org/sadar/pec2##incidentId> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain <http://www.semanticweb.org/sadar/pec2##Incident> ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "Stores the identifier of an Incident." ;
                                                    rdfs:label "incidentId" .


###  http://www.semanticweb.org/sadar/pec2##intendedPurpose
<http://www.semanticweb.org/sadar/pec2##intendedPurpose> rdf:type owl:DatatypeProperty ;
                                                         rdfs:domain <http://www.semanticweb.org/sadar/pec2##Device> ;
                                                         rdfs:range xsd:string ;
                                                         rdfs:comment "Stores the intended purpose of a Device." ;
                                                         rdfs:label "intendedPurpose" .


###  http://www.semanticweb.org/sadar/pec2##manufacturerName
<http://www.semanticweb.org/sadar/pec2##manufacturerName> rdf:type owl:DatatypeProperty ;
                                                          rdfs:domain <http://www.semanticweb.org/sadar/pec2##Manufacturer> ;
                                                          rdfs:range xsd:string ;
                                                          rdfs:comment "Stores the name of a Manufacturer." ;
                                                          rdfs:label "manufacturerName" .


###  http://www.semanticweb.org/sadar/pec2##reportDate
<http://www.semanticweb.org/sadar/pec2##reportDate> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain <http://www.semanticweb.org/sadar/pec2##Incident> ;
                                                    rdfs:range xsd:dateTime ;
                                                    rdfs:comment "Stores the report date of an Incident." ;
                                                    rdfs:label "reportDate" .


###  http://www.semanticweb.org/sadar/pec2##riskName
<http://www.semanticweb.org/sadar/pec2##riskName> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <http://www.semanticweb.org/sadar/pec2##Risk> ;
                                                  rdfs:range xsd:string ;
                                                  rdfs:comment "Stores the name of a Risk." ;
                                                  rdfs:label "riskName" .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/sadar/pec2##ActionStatus
<http://www.semanticweb.org/sadar/pec2##ActionStatus> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##CorrectiveAction> ;
                                                      rdfs:comment "Represents the status of a corrective action (e.g., pending, completed)." ;
                                                      rdfs:label "ActionStatus" .


###  http://www.semanticweb.org/sadar/pec2##ActiveDevice
<http://www.semanticweb.org/sadar/pec2##ActiveDevice> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##MedicalDevice> ;
                                                      rdfs:comment "Represents a medical device that depends on a source of energy other than that generated by the human body." ;
                                                      rdfs:label "ActiveDevice" .


###  http://www.semanticweb.org/sadar/pec2##CompetentAuthority
<http://www.semanticweb.org/sadar/pec2##CompetentAuthority> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##Manufacturer> ;
                                                            rdfs:comment "Represents an official authority responsible for regulating and supervising medical devices." ;
                                                            rdfs:label "CompetentAuthority" .


###  http://www.semanticweb.org/sadar/pec2##CorrectiveAction
<http://www.semanticweb.org/sadar/pec2##CorrectiveAction> rdf:type owl:Class ;
                                                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.semanticweb.org/sadar/pec2##isCorrectiveActionFor> ;
                                                                            owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Incident>
                                                                          ] ;
                                                          rdfs:comment "Represents a corrective action applied in response to an incident." ;
                                                          rdfs:label "CorrectiveAction" .


###  http://www.semanticweb.org/sadar/pec2##CriticalRisk
<http://www.semanticweb.org/sadar/pec2##CriticalRisk> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##Risk> .


###  http://www.semanticweb.org/sadar/pec2##Device
<http://www.semanticweb.org/sadar/pec2##Device> rdf:type owl:Class ;
                                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasManufacturer> ;
                                                                  owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Manufacturer>
                                                                ] ;
                                                rdfs:comment "Represents a medical device or an in vitro diagnostic device." ;
                                                rdfs:label "Device" .


###  http://www.semanticweb.org/sadar/pec2##DeviceType
<http://www.semanticweb.org/sadar/pec2##DeviceType> rdf:type owl:Class ;
                                                    rdfs:comment "Represents the regulatory risk classification of a device." ;
                                                    rdfs:label "DeviceType" .


###  http://www.semanticweb.org/sadar/pec2##HighRiskDevice
<http://www.semanticweb.org/sadar/pec2##HighRiskDevice> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##MedicalDevice> ;
                                                        rdfs:comment "Represents a medical device classified as high risk based on regulatory criteria." ;
                                                        rdfs:label "HighRiskDevice" .


###  http://www.semanticweb.org/sadar/pec2##IVDRDevice
<http://www.semanticweb.org/sadar/pec2##IVDRDevice> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##InVitroDiagnosticDevice> ;
                                                    rdfs:comment "Represents an in vitro diagnostic device regulated under the IVDR." ;
                                                    rdfs:label "IVDRDevice" .


###  http://www.semanticweb.org/sadar/pec2##ImplantableDevice
<http://www.semanticweb.org/sadar/pec2##ImplantableDevice> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##MedicalDevice> ;
                                                           rdfs:comment "Represents a medical device intended to be totally or partially introduced into the human body." ;
                                                           rdfs:label "ImplantableDevice" .


###  http://www.semanticweb.org/sadar/pec2##InVitroDiagnosticDevice
<http://www.semanticweb.org/sadar/pec2##InVitroDiagnosticDevice> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##Device> ;
                                                                 rdfs:comment "Represents a device used for the in vitro examination of samples derived from the human body." ;
                                                                 rdfs:label "InVitroDiagnosticDevice" .


###  http://www.semanticweb.org/sadar/pec2##Incident
<http://www.semanticweb.org/sadar/pec2##Incident> rdf:type owl:Class ;
                                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.semanticweb.org/sadar/pec2##hasRisk> ;
                                                                    owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Risk>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.semanticweb.org/sadar/pec2##involvesDevice> ;
                                                                    owl:someValuesFrom <http://www.semanticweb.org/sadar/pec2##Device>
                                                                  ] ;
                                                  rdfs:comment "Represents an incident associated with a device." .


###  http://www.semanticweb.org/sadar/pec2##IncidentType
<http://www.semanticweb.org/sadar/pec2##IncidentType> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##Incident> ;
                                                      rdfs:comment "Represents the classification or type of an incident." ;
                                                      rdfs:label "IncidentType" .


###  http://www.semanticweb.org/sadar/pec2##MDRDevice
<http://www.semanticweb.org/sadar/pec2##MDRDevice> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##MedicalDevice> ;
                                                   rdfs:comment "Represents a medical device regulated under the Medical Device Regulation (MDR)." ;
                                                   rdfs:label "MDRDevice" .


###  http://www.semanticweb.org/sadar/pec2##Manufacturer
<http://www.semanticweb.org/sadar/pec2##Manufacturer> rdf:type owl:Class ;
                                                      rdfs:comment "Represents a manufacturer of medical devices." ;
                                                      rdfs:label "Manufacturer" .


###  http://www.semanticweb.org/sadar/pec2##MedicalDevice
<http://www.semanticweb.org/sadar/pec2##MedicalDevice> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##Device> ;
                                                       rdfs:comment "Represents a medical device as defined by applicable medical regulations." ;
                                                       rdfs:label "MedicalDevice" .


###  http://www.semanticweb.org/sadar/pec2##ProbabilityLevel
<http://www.semanticweb.org/sadar/pec2##ProbabilityLevel> rdf:type owl:Class ;
                                                          rdfs:comment "Represents the probability level associated with a risk occurrence." ;
                                                          rdfs:label "ProbabilityLevel" .


###  http://www.semanticweb.org/sadar/pec2##RegulatoryFramework
<http://www.semanticweb.org/sadar/pec2##RegulatoryFramework> rdf:type owl:Class ;
                                                             rdfs:comment "Represents the regulatory framework or legislation applicable to a medical device (e.g., MDR, IVDR)." ;
                                                             rdfs:label "RegulatoryFramework" .


###  http://www.semanticweb.org/sadar/pec2##RequiresMonitoring
<http://www.semanticweb.org/sadar/pec2##RequiresMonitoring> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##Device> ;
                                                            rdfs:comment "Represents a device that requires continuous or periodic monitoring during its use." ;
                                                            rdfs:label "RequiresMonitoring" .


###  http://www.semanticweb.org/sadar/pec2##ReusableDevice
<http://www.semanticweb.org/sadar/pec2##ReusableDevice> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##MedicalDevice> ;
                                                        rdfs:comment "Represents a medical device intended to be used multiple times." ;
                                                        rdfs:label "ReusableDevice" .


###  http://www.semanticweb.org/sadar/pec2##Risk
<http://www.semanticweb.org/sadar/pec2##Risk> rdf:type owl:Class ;
                                              rdfs:comment "Represents a risk associated with a medical device or incident." ;
                                              rdfs:label "Risk" ;
                                              rdfs:seeAlso "https://dbpedia.org/page/Risk" .


###  http://www.semanticweb.org/sadar/pec2##RiskClass
<http://www.semanticweb.org/sadar/pec2##RiskClass> rdf:type owl:Class ;
                                                   rdfs:comment "Represents the classification of a device according to its level of risk." ;
                                                   rdfs:label "RiskClass" .


###  http://www.semanticweb.org/sadar/pec2##SeriousIncident
<http://www.semanticweb.org/sadar/pec2##SeriousIncident> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://www.semanticweb.org/sadar/pec2##Incident> ;
                                                         rdfs:comment "Represents an incident that has serious consequences such as death or serious deterioration of health." ;
                                                         rdfs:label "SeriousIncident" .


###  http://www.semanticweb.org/sadar/pec2##SeverityLevel
<http://www.semanticweb.org/sadar/pec2##SeverityLevel> rdf:type owl:Class ;
                                                       rdfs:comment "Represents the severity level of a risk or incident." ;
                                                       rdfs:label "SeverityLevel" .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/sadar/pec2##Abbott_Medical_Devices_MAN002
<http://www.semanticweb.org/sadar/pec2##Abbott_Medical_Devices_MAN002> rdf:type owl:NamedIndividual ,
                                                                                <http://www.semanticweb.org/sadar/pec2##Manufacturer> ;
                                                                       <http://www.semanticweb.org/sadar/pec2##deviceId> "Germany" ;
                                                                       <http://www.semanticweb.org/sadar/pec2##manufacturerName> "Abbott Medical Devices" .


###  http://www.semanticweb.org/sadar/pec2##HeartMate3LVAD_DEV001
<http://www.semanticweb.org/sadar/pec2##HeartMate3LVAD_DEV001> rdf:type owl:NamedIndividual ,
                                                                        <http://www.semanticweb.org/sadar/pec2##Device> ;
                                                               <http://www.semanticweb.org/sadar/pec2##hasManufacturer> <http://www.semanticweb.org/sadar/pec2##Medtronic_plc_MAN001> ;
                                                               <http://www.semanticweb.org/sadar/pec2##deviceIdentifier> "DEV-001" ;
                                                               <http://www.semanticweb.org/sadar/pec2##deviceName> "HeartMate 3 LVAD" ;
                                                               <http://www.semanticweb.org/sadar/pec2##deviceType> "ImplantableActiveDevice" ;
                                                               <http://www.semanticweb.org/sadar/pec2##intendedPurpose> "Ventricular assist device for end-stage heart failure" .


###  http://www.semanticweb.org/sadar/pec2##Incident_INC001
<http://www.semanticweb.org/sadar/pec2##Incident_INC001> rdf:type owl:NamedIndividual ,
                                                                  <http://www.semanticweb.org/sadar/pec2##Incident> ;
                                                         <http://www.semanticweb.org/sadar/pec2##hasRisk> <http://www.semanticweb.org/sadar/pec2##PumpFailureRisk_R001> ;
                                                         <http://www.semanticweb.org/sadar/pec2##involvesDevice> <http://www.semanticweb.org/sadar/pec2##HeartMate3LVAD_DEV001> ;
                                                         <http://www.semanticweb.org/sadar/pec2##incidentId> "INC-001" ;
                                                         <http://www.semanticweb.org/sadar/pec2##reportDate> "2023-03-15T09:30:00"^^xsd:dateTime .



                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :isCorrectiveActionFor ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <http://www.representacionconocimientopec2.org//c> ;

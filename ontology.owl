    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.representacionconocimientopec2.org/Abbott_Medical_Devices_MAN002 -->


    <owl:NamedIndividual rdf:about="http://www.representacionconocimientopec2.org/Abbott_Medical_Devices_MAN002">

                                <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/sadar/pec2##isCorrectiveActionFor"/>
                                <swrl:argument1 rdf:resource="http://www.semanticweb.org/sadar/ontologies/2026/2/c"/>

<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/sadar/pec2#"
     xml:base="http://www.semanticweb.org/sadar/pec2"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:pec2="http://www.semanticweb.org/sadar/pec2##"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/sadar/pec2#">
        <rdfs:comment>This ontology models medical devices, incidents, risks and corrective actions to support risk management and safety analysis.</rdfs:comment>
        <rdfs:comment>https://creativecommons.org/licenses/by/4.0/</rdfs:comment>
        <rdfs:label>Medical Device Risk Management Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/sadar/pec2##hasCorrectiveAction -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sadar/pec2##hasCorrectiveAction">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/sadar/pec2##isCorrectiveActionFor"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Incident"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##CorrectiveAction"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relates an Incident to a CorrectiveAction applied to it.</rdfs:comment>
        <rdfs:label>hasCorrectiveAction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##hasManufacturer -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sadar/pec2##hasManufacturer">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/sadar/pec2##manufactures"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Manufacturer"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relates a Device to its Manufacturer.</rdfs:comment>
        <rdfs:label>hasManufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##hasRisk -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sadar/pec2##hasRisk">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Incident"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Risk"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relates an Incident to an identified Risk.</rdfs:comment>
        <rdfs:label>hasRisk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##hasRiskClass -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sadar/pec2##hasRiskClass">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##RiskClass"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relates a Device to its RiskClass.</rdfs:comment>
        <rdfs:label>hasRiskClass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##involvesDevice -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sadar/pec2##involvesDevice">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Incident"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relates an Incident to the Device involved in it.</rdfs:comment>
        <rdfs:label>involvesDevice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##isCorrectiveActionFor -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sadar/pec2##isCorrectiveActionFor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##CorrectiveAction"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Incident"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relates a CorrectiveAction to the Incident it addresses.</rdfs:comment>
        <rdfs:label>isCorrectiveActionFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##manufactures -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sadar/pec2##manufactures">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Manufacturer"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relates a Manufacturer to the Devices it produces.</rdfs:comment>
        <rdfs:label>manufactures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##reportedBy -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/sadar/pec2##reportedBy">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Incident"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Manufacturer"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment>Relates an Incident to the Manufacturer that reported it.</rdfs:comment>
        <rdfs:label>reportedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/sadar/pec2##actionType -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##actionType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##CorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the type of a CorrectiveAction.</rdfs:comment>
        <rdfs:label>actionType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##deviceId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##deviceId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the country of a Manufacturer.</rdfs:comment>
        <rdfs:label>country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##deviceIdentifier -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##deviceIdentifier">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasRiskClass"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##RiskClass"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the identifier of a Device.</rdfs:comment>
        <rdfs:label>deviceIdentifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##deviceName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##deviceName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the name of a Device.</rdfs:comment>
        <rdfs:label>deviceName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##deviceType -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##deviceType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the type of a Device as a controlled literal value.</rdfs:comment>
        <rdfs:label>deviceType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##incidentId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##incidentId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the identifier of an Incident.</rdfs:comment>
        <rdfs:label>incidentId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##intendedPurpose -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##intendedPurpose">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the intended purpose of a Device.</rdfs:comment>
        <rdfs:label>intendedPurpose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##manufacturerName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##manufacturerName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the name of a Manufacturer.</rdfs:comment>
        <rdfs:label>manufacturerName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##reportDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##reportDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Stores the report date of an Incident.</rdfs:comment>
        <rdfs:label>reportDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/sadar/pec2##riskName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/sadar/pec2##riskName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/sadar/pec2##Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the name of a Risk.</rdfs:comment>
        <rdfs:label>riskName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/sadar/pec2##ActionStatus -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##ActionStatus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##CorrectiveAction"/>
        <rdfs:comment>Represents the status of a corrective action (e.g., pending, completed).</rdfs:comment>
        <rdfs:label>ActionStatus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##ActiveDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##ActiveDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##MedicalDevice"/>
        <rdfs:comment>Represents a medical device that depends on a source of energy other than that generated by the human body.</rdfs:comment>
        <rdfs:label>ActiveDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##CompetentAuthority -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##CompetentAuthority">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##Manufacturer"/>
        <rdfs:comment>Represents an official authority responsible for regulating and supervising medical devices.</rdfs:comment>
        <rdfs:label>CompetentAuthority</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##CorrectiveAction -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##CorrectiveAction">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##isCorrectiveActionFor"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Incident"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents a corrective action applied in response to an incident.</rdfs:comment>
        <rdfs:label>CorrectiveAction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##CriticalRisk -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##CriticalRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##Risk"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##Device -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##Device">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents a medical device or an in vitro diagnostic device.</rdfs:comment>
        <rdfs:label>Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##DeviceType -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##DeviceType">
        <rdfs:comment>Represents the regulatory risk classification of a device.</rdfs:comment>
        <rdfs:label>DeviceType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##HighRiskDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##HighRiskDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##MedicalDevice"/>
        <rdfs:comment>Represents a medical device classified as high risk based on regulatory criteria.</rdfs:comment>
        <rdfs:label>HighRiskDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##IVDRDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##IVDRDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##InVitroDiagnosticDevice"/>
        <rdfs:comment>Represents an in vitro diagnostic device regulated under the IVDR.</rdfs:comment>
        <rdfs:label>IVDRDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##ImplantableDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##ImplantableDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##MedicalDevice"/>
        <rdfs:comment>Represents a medical device intended to be totally or partially introduced into the human body.</rdfs:comment>
        <rdfs:label>ImplantableDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##InVitroDiagnosticDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##InVitroDiagnosticDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
        <rdfs:comment>Represents a device used for the in vitro examination of samples derived from the human body.</rdfs:comment>
        <rdfs:label>InVitroDiagnosticDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##Incident -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##Incident">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##hasRisk"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/sadar/pec2##involvesDevice"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents an incident associated with a device.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##IncidentType -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##IncidentType">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##Incident"/>
        <rdfs:comment>Represents the classification or type of an incident.</rdfs:comment>
        <rdfs:label>IncidentType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##MDRDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##MDRDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##MedicalDevice"/>
        <rdfs:comment>Represents a medical device regulated under the Medical Device Regulation (MDR).</rdfs:comment>
        <rdfs:label>MDRDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##Manufacturer -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##Manufacturer">
        <rdfs:comment>Represents a manufacturer of medical devices.</rdfs:comment>
        <rdfs:label>Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##MedicalDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##MedicalDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
        <rdfs:comment>Represents a medical device as defined by applicable medical regulations.</rdfs:comment>
        <rdfs:label>MedicalDevice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##ProbabilityLevel -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##ProbabilityLevel">
        <rdfs:comment>Represents the probability level associated with a risk occurrence.</rdfs:comment>
        <rdfs:label>ProbabilityLevel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##RegulatoryFramework -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##RegulatoryFramework">
        <rdfs:comment>Represents the regulatory framework or legislation applicable to a medical device (e.g., MDR, IVDR).</rdfs:comment>
        <rdfs:label>RegulatoryFramework</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/sadar/pec2##RequiresMonitoring -->


    <owl:Class rdf:about="http://www.semanticweb.org/sadar/pec2##RequiresMonitoring">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/sadar/pec2##Device"/>
        <rdfs:comment>Represents a device that requires continuous or periodic monitoring during its use.</rdfs:comment>
